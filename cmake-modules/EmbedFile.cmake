# Generates a C++ source that holds a file's bytes as a constant array.
#
# cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DNAMESPACE=<ns> -DNAME=<identifier> -P EmbedFile.cmake
#
# The generated source defines:
#   extern const unsigned char NAME[];        // the file bytes, followed by a terminating 0 (not counted)
#   extern const std::size_t NAME_SIZE;       // the file size in bytes

file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" hexLength)
math(EXPR size "${hexLength} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," content "${content}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" content "${content}")

file(WRITE "${OUTPUT}.tmp"
        "// Generated by EmbedFile.cmake from ${INPUT}. Do not edit.\n"
        "#include <cstddef>\n\n"
        "namespace ${NAMESPACE}\n{\n"
        "\textern const unsigned char ${NAME}[];\n"
        "\textern const std::size_t ${NAME}_SIZE;\n\n"
        "\tconst unsigned char ${NAME}[] = {\n${content}\n0x00 };\n"
        "\tconst std::size_t ${NAME}_SIZE = ${size};\n}\n")
# configure_file only rewrites the output when it changed, so dependents are not rebuilt needlessly
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)
file(REMOVE "${OUTPUT}.tmp")
