if (NOT ELPIDA_VERSION_MAJOR)
   set(ELPIDA_VERSION_MAJOR 0)
endif()

if (NOT ELPIDA_VERSION_MINOR)
   set(ELPIDA_VERSION_MINOR 0)
endif()

if (NOT ELPIDA_VERSION_REVISION)
   set(ELPIDA_VERSION_REVISION 1)
endif()

if (NOT ELPIDA_VERSION_BUILD)
   set(ELPIDA_VERSION_BUILD 1000)
endif()

if (NOT ELPIDA_COMPANY_NAME)
    set(ELPIDA_COMPANY_NAME "Ioannis Panagiotopoulos")
endif()

if (ELPIDA_BETA EQUAL 1)
    add_definitions(-DELPIDA_BETA=1)
endif()

set(ELPIDA_VERSION ${ELPIDA_VERSION_MAJOR}.${ELPIDA_VERSION_MINOR}.${ELPIDA_VERSION_REVISION}.${ELPIDA_VERSION_BUILD})

if (NOT ELPIDA_WEBSITE)
    set(ELPIDA_WEBSITE "https://www.elpida.dev")
endif()

set(ELPIDA_BENCHMARKS_VERSION_MAJOR 1)
set(ELPIDA_BENCHMARKS_VERSION_MINOR 0)
set(ELPIDA_BENCHMARKS_VERSION_REVISION 0)
set(ELPIDA_BENCHMARKS_VERSION_BUILD ${ELPIDA_VERSION_BUILD})
set(ELPIDA_BENCHMARKS_VERSION ${ELPIDA_BENCHMARKS_VERSION_MAJOR}.${ELPIDA_BENCHMARKS_VERSION_MINOR}.${ELPIDA_BENCHMARKS_VERSION_REVISION}.${ELPIDA_BENCHMARKS_VERSION_BUILD})