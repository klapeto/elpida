set(CMAKE_SYSTEM_NAME ${TARGET_SYSTEM})
set(CMAKE_SYSTEM_PROCESSOR ${TARGET_ARCH})
set(CMAKE_SYSROOT ${TARGET_SYSROOT})
set(CMAKE_LINKER_TYPE LLD)

if (TARGET_PREFIX)
    set(CMAKE_C_FLAGS "--sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_CXX_FLAGS "--sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_LD_FLAGS "--sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_ASM_FLAGS "--sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_C_COMPILER ${TARGET_PREFIX}clang)
    set(CMAKE_CXX_COMPILER ${TARGET_PREFIX}clang++)
    set(CMAKE_ASM_COMPILER ${TARGET_PREFIX}clang)
else ()
    set(CMAKE_C_FLAGS "--target=${CLANG_TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_CXX_FLAGS "--target=${CLANG_TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_LD_FLAGS "--target=${CLANG_TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_ASM_FLAGS "--target=${CLANG_TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
    set(CMAKE_C_COMPILER clang)
    set(CMAKE_CXX_COMPILER clang++)
    set(CMAKE_ASM_COMPILER clang)
endif ()

if (MCPU)
    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mcpu=${MCPU}")
    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -mcpu=${MCPU}")
endif ()

set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)