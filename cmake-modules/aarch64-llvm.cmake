set(TARGET_TRIPLE aarch64-linux-gnu)
set(CMAKE_SYSROOT /home/klapeto/dev/aarch64-linux-gnu)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_LINKER_TYPE LLD)
set(CMAKE_C_FLAGS "--target=${TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
set(CMAKE_CXX_FLAGS  "--target=${TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
set(CMAKE_LD_FLAGS  "--target=${TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
set(CMAKE_ASM_FLAGS  "--target=${TARGET_TRIPLE} --sysroot=${CMAKE_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
