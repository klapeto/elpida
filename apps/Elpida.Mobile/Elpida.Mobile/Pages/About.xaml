<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Elpida.Mobile.Controls"
             xmlns:strings="clr-namespace:Elpida.Mobile"
             xmlns:viewModels="clr-namespace:Elpida.Mobile.ViewModels"
             x:DataType="viewModels:AboutViewModel"
             x:Class="Elpida.Mobile.Pages.About">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="8" Spacing="10">
                <Image Source="elpida_logo.png"/>
                <controls:GroupBox Title="{x:Static strings:Resources.VersionInfo}">
	                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *" ColumnSpacing="5">
		                <Label Grid.Row="0" Grid.Column="0" Text="{x:Static strings:Resources.Version}"/>
		                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Version}"/>
		                <Label Grid.Row="1" Grid.Column="0" Text="{x:Static strings:Resources.Compiler}"/>
		                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Compiler}"/>
	                </Grid>
                </controls:GroupBox>

                <controls:GroupBox Title="{x:Static strings:Resources.Brief}">
	                <Label>
		                Elpida is an open and free benchmarking framework aiming to provide a transparent way to benchmark algorithms/systems with no closed source components. This way everything is benchmarked on equal ground with no result skews. The website/Http Api was created to store anonymously results so that users can compare similar systems as well as create statistics. The benchmarks try to be as varied as possible and use real-world libraries. This is to avoid making the results biased towards specific vendors or architectures.
	                </Label>
                </controls:GroupBox>
        
                <controls:GroupBox Title="{x:Static strings:Resources.PrivacyDisclaimer}">
	                <Label TextType="Html" Text="{x:Static strings:Resources.PrivacyDisclaimerText}"/> 
                </controls:GroupBox>
                <Label Style="{StaticResource Header2}" Text="{x:Static strings:Resources.MoreInfo}"/>
                <controls:Hyperlink Style="{StaticResource Header2}" Text="https://www.elpida.dev" Url="https://www.elpida.dev" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>