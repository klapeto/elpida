<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Elpida.Mobile.Views"
             xmlns:viewmodels="clr-namespace:Elpida.Mobile.ViewModels"
             xmlns:views1="clr-namespace:Elpida.Mobile.Views"
             xmlns:converters="clr-namespace:Elpida.Mobile.Converters"
             xmlns:strings="clr-namespace:Elpida.Mobile"
             x:DataType="viewmodels:MainPageViewModel"
             x:Class="Elpida.Mobile.Pages.MainPage">
	
	<ScrollView>
		<VerticalStackLayout
			Padding="8"
			>
			
			<Label 
				Text="{x:Static strings:Resources.Welcome}"
				Style="{StaticResource Headline}"
				SemanticProperties.HeadingLevel="Level1"
				Margin="0, 0, 0, 8"
				/>
			
			<VerticalStackLayout
				HorizontalOptions="Center"
				VerticalOptions="Center"
				IsVisible="{Binding SystemInfo.Loaded, Converter={x:StaticResource NegatingConverter}}"
			>
				<ActivityIndicator IsRunning="true"
				                   Color="Black"
				                   SemanticProperties.Description="{x:Static strings:Resources.Loading}" />
				<Label 
					Style="{StaticResource SubHeadline}"
					SemanticProperties.HeadingLevel="Level2"
					Text="{x:Static strings:Resources.SystemInfoLoading}" />
			</VerticalStackLayout>
			
			<views1:SystemInfoView BindingContext="{Binding SystemInfo}" IsVisible="{Binding Loaded, FallbackValue=false}"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
