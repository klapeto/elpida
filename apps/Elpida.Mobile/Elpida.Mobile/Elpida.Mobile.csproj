<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
        The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
        When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
        The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
        either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
        <Company>klapeto</Company>
        <Product>Elpida.dev Mobile</Product>
        <OutputType>Exe</OutputType>
        <RootNamespace>Elpida.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en-US</NeutralLanguage>
        <BeforeGenerateAndroidManifest>BuildNativeLibrary</BeforeGenerateAndroidManifest>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Elpida.dev Mobile</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>dev.elpida.mobile</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

        <!-- The ABIs the native code is built for (NativeAbi in BuildNativeLibrary). .NET's default leaves out android-arm. -->
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>

        <AndroidSdkBuildToolsVersion Condition=" '$(AndroidSdkBuildToolsVersion)' == '' ">34.0.0</AndroidSdkBuildToolsVersion>
        <AndroidSdkPlatformToolsVersion Condition="'$(AndroidSdkPlatformToolsVersion)' == ''">34.0.0</AndroidSdkPlatformToolsVersion>
        <AndroidSdkPlatformVersion Condition=" '$(AndroidSdkPlatformVersion)' == '' ">android-21</AndroidSdkPlatformVersion>


        <AndroidCommandLineToolsVersion Condition=" '$(AndroidCommandLineToolsVersion)' == '' ">19.0</AndroidCommandLineToolsVersion>
        <JavaSdkVersion Condition="'$(JavaSdkVersion)' == ''">21.0.8</JavaSdkVersion>

        <!-- Native code is built with the same llvm-mingw toolchain as every other platform (docs/development/android-toolchain.md).
             The Android targets are created by llvm-mingw's build-android-sysroots.sh. -->
        <ElpidaToolchainDirectory Condition="'$(ElpidaToolchainDirectory)' == ''">$(ELPIDA_TOOLCHAIN)</ElpidaToolchainDirectory>
        <ElpidaToolchainDirectory Condition="'$(ElpidaToolchainDirectory)' == ''">/mnt/Dev/toolchains/llvm-mingw</ElpidaToolchainDirectory>
        <!-- API levels of the two native builds (see Platforms/Android/Native/CMakeLists.txt). The toolchain targets for
             both must exist (ANDROID_API of build-android-sysroots.sh). The benchmarks are static executables, so 29
             does not limit the devices; the app part must match the minSdk (SupportedOSPlatformVersion). -->
        <ElpidaAndroidBenchmarksApi Condition="'$(ElpidaAndroidBenchmarksApi)' == ''">29</ElpidaAndroidBenchmarksApi>
        <ElpidaAndroidAppApi Condition="'$(ElpidaAndroidAppApi)' == ''">21</ElpidaAndroidAppApi>
        <MinimumSupportedJavaVersion Condition="'$(MinimumSupportedJavaVersion)' == ''">17.0</MinimumSupportedJavaVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#e5e8fd"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#e5e8fd" BaseSize="128,128"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <MauiXaml Update="Pages\MainPage.xaml">
            <SubType>Designer</SubType>
        </MauiXaml>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Pages\MainPage.xaml.cs">
            <DependentUpon>MainPage.xaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Properties\Resources.Designer.cs">
          <DesignTime>True</DesignTime>
          <AutoGen>True</AutoGen>
          <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Properties\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <Target Name="BuildNativeLibrary"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ItemGroup>
            <NativeAbi Include="x86_64" Triple="x86_64-linux-android"/>
            <NativeAbi Include="arm64-v8a" Triple="aarch64-linux-android"/>
            <NativeAbi Include="armeabi-v7a" Triple="armv7a-linux-androideabi"/>
            <NativePart Include="benchmarks" Api="$(ElpidaAndroidBenchmarksApi)"/>
            <NativePart Include="app" Api="$(ElpidaAndroidAppApi)"/>
            <NativeBuild Include="@(NativeAbi)" Part="%(NativePart.Identity)" Api="%(NativePart.Api)"/>
        </ItemGroup>

        <Exec EnvironmentVariables="PATH=$(ElpidaToolchainDirectory)/bin:$(PATH)"
              Command="cmake -DCMAKE_BUILD_TYPE=Release -DELPIDA_ENABLE_CLI=OFF -DELPIDA_ENABLE_QT=OFF -DELPIDA_ENABLE_APPLICATION_LIBRARIES=ON -DELPIDA_ANDROID_PART=%(NativeBuild.Part) -S &quot;$(ProjectDir)Platforms/Android/Native&quot; -B &quot;$(ProjectDir)Platforms/Android/libs/%(NativeBuild.Identity)/%(NativeBuild.Part)&quot; -DCMAKE_TOOLCHAIN_FILE=&quot;$(ProjectDir)../../../cmake-modules/llvm-cross.cmake&quot; -DTARGET_PREFIX=%(NativeBuild.Triple)%(NativeBuild.Api)- -DCMAKE_SYSROOT=&quot;$(ElpidaToolchainDirectory)/%(NativeBuild.Triple)%(NativeBuild.Api)&quot; -G Ninja"/>
        <Exec EnvironmentVariables="PATH=$(ElpidaToolchainDirectory)/bin:$(PATH)"
              Command="cmake --build &quot;$(ProjectDir)Platforms/Android/libs/%(NativeBuild.Identity)/%(NativeBuild.Part)&quot;"/>
    </Target>
    
    <Target Name="CopyBinaries" AfterTargets="BuildNativeLibrary" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ItemGroup>
            <!-- libElpida.so is P/Invoked; the others are executables (lib*.so so that Android extracts them) -->
            <!-- explicit Abi: it cannot be inferred from the path because of the app/ and benchmarks/ directories -->
            <AndroidNativeLibrary Include="Platforms/Android/libs/%(NativeAbi.Identity)/app/libElpida.so;Platforms/Android/libs/%(NativeAbi.Identity)/app/libelpida-info-dumper.so;Platforms/Android/libs/%(NativeAbi.Identity)/app/libstdlib-benchmarks.so;Platforms/Android/libs/%(NativeAbi.Identity)/benchmarks/lib*-benchmarks.so" Abi="%(NativeAbi.Identity)"/>
        </ItemGroup>
    </Target>

</Project>
