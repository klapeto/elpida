<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Elpida.Mobile.ViewModels"
             xmlns:strings="clr-namespace:Elpida.Mobile"
             x:DataType="viewModels:CpuInfoViewModel"
             x:Class="Elpida.Mobile.Views.CpuInfoView">

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
        <Label Grid.Row="0"
               Grid.Column="0"
               Text="{x:Static strings:Resources.Architecture}" FontAttributes="Bold" />
        <Label Grid.Row="0"
               Grid.Column="1"
               Text="{Binding Architecture}" />

        <Label
            Grid.Row="1"
            Grid.Column="0"
            Text="{x:Static strings:Resources.Vendor}" FontAttributes="Bold" />
        <Label
            Grid.Row="1"
            Grid.Column="1" Text="{Binding Vendor}" />

        <Label
            Grid.Row="2"
            Grid.Column="0"
            Text="{x:Static strings:Resources.ModelName}" FontAttributes="Bold" />
        <Label
            Grid.Row="2"
            Grid.Column="1"
            Text="{Binding ModelName}" />
    </Grid>
</ContentView>