<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Elpida.Mobile.ViewModels"
             x:DataType="viewModels:ResultViewModel"
             x:Class="Elpida.Mobile.Views.ResultView">

    <HorizontalStackLayout>
        <Label Text="{Binding Value, FallbackValue='N/A', Converter={StaticResource SiValueConverter}, ConverterParameter=2}"/> 
        <Label Text="{Binding RelativeChange, FallbackValue=' (N/A%)', StringFormat=' ({0}%)', Converter={StaticResource RelativeChangeValueConverter}, ConverterParameter=2}"
               Style="{StaticResource RelativeChangeLabelStyle}"/>
    </HorizontalStackLayout>
</ContentView>