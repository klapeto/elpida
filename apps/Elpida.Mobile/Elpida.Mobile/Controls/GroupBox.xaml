<?xml version="1.0" encoding="utf-8"?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Elpida.Mobile.Controls"
    x:Class="Elpida.Mobile.Controls.GroupBox"
    x:DataType="controls:GroupBox">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border Style="{StaticResource GroupBoxHeaderBorder}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
                    <VerticalStackLayout Grid.Row="0">
                        <HorizontalStackLayout HorizontalOptions="Center" Padding="9">
                            <Image IsVisible="{Binding ShowIcon}" 
                                   Source="{TemplateBinding Icon}" 
                                   Style="{StaticResource GroupBoxIcon}" />
                            <Label Text="{TemplateBinding Title}" 
                                   Style="{StaticResource GroupBoxHeader}" />  
                        </HorizontalStackLayout>
                        <BoxView
                            Style="{StaticResource GroupBoxHeaderBox}"
                            HeightRequest="1"
                            HorizontalOptions="Fill" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Padding="7" Style="{StaticResource GroupBoxContentLayout}">
                        <ContentPresenter />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>