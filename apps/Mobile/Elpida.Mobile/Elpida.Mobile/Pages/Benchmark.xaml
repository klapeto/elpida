<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Elpida.Mobile.Controls"
             xmlns:viewmodels="clr-namespace:Elpida.Mobile.ViewModels"
             xmlns:views="clr-namespace:Elpida.Mobile.Views"
             xmlns:strings="clr-namespace:Elpida.Mobile"
             x:DataType="viewmodels:BenchmarkPageViewModel"
             x:Class="Elpida.Mobile.Pages.Benchmark">
    <ScrollView>
        <VerticalStackLayout>
            <controls:GroupBox Margin="8" Title="{x:Static strings:Resources.Score}">
                <VerticalStackLayout>
                    <views:ResultView BindingContext="{Binding LastResult.TotalScore}">
                        <views:ResultView.Resources>
                            <Style TargetType="Label" BasedOn="{StaticResource Header}" />
                            <Style TargetType="HorizontalStackLayout">
                                <Setter Property="HorizontalOptions" Value="Center" />
                                <Setter Property="Margin" Value="12" />
                            </Style>
                        </views:ResultView.Resources>
                    </views:ResultView>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                        <Label Grid.Row="0" Grid.Column="0" Text="{x:Static strings:Resources.SingleThreadLabel}" Style="{StaticResource Header3}" />
                        <views:ResultView Grid.Row="0" Grid.Column="1"
                                          BindingContext="{Binding LastResult.SingleThreadScore}">
                            <views:ResultView.Resources>
                                <Style TargetType="Label" BasedOn="{StaticResource Header3}" />
                                <Style TargetType="HorizontalStackLayout">
                                    <Setter Property="HorizontalOptions" Value="Center" />
                                </Style>
                            </views:ResultView.Resources>
                        </views:ResultView>
                        <Label Grid.Row="1" Grid.Column="0" Text="{x:Static strings:Resources.MultiThreadLabel}" Style="{StaticResource Header3}" />
                        <views:ResultView Grid.Row="1" Grid.Column="1"
                                          BindingContext="{Binding LastResult.MultiThreadScore}">
                            <views:ResultView.Resources>
                                <Style TargetType="Label" BasedOn="{StaticResource Header3}" />
                                <Style TargetType="HorizontalStackLayout">
                                    <Setter Property="HorizontalOptions" Value="Center" />
                                </Style>
                            </views:ResultView.Resources>
                        </views:ResultView>
                    </Grid>
                </VerticalStackLayout>
            </controls:GroupBox>
            <controls:GroupBox Margin="8" Title="{x:Static strings:Resources.Execution}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*">
                    <Label Grid.Row="0" Grid.Column="0" Text="{x:Static strings:Resources.CurrentBenchmark}" />
                    <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding ExecutingBenchmark.Name, FallbackValue='N/A'}" />

                    <ProgressBar Progress="{Binding Progress}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" />
                    <Label Grid.Row="1" Grid.Column="2">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding ExecutedBenchmarks}" />
                                <Span Text="/" />
                                <Span Text="{Binding BenchmarkCount}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Grid.Row="2" Grid.Column="0" VerticalTextAlignment="Center" Text="{x:Static strings:Resources.RunIt}" />
                    <Entry Grid.Row="2" Grid.Column="1"
                           Keyboard="Numeric"
                           Text="{Binding RunItTimes}" />
                    <Label Grid.Row="2" Grid.Column="2" VerticalTextAlignment="Center" Text="{x:Static strings:Resources.Times}" />

                    <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                        <CheckBox IsChecked="{Binding UploadResults}" />
                        <Label VerticalTextAlignment="Center" Text="{x:Static strings:Resources.UploadResultsAnonymously}" />
                    </HorizontalStackLayout>

                    <Button Grid.Row="4" Grid.Column="0" Command="{Binding RunBenchmarkCommand}" Text="{Binding ButtonText}" />
                    <Label Grid.Row="4" Grid.Column="1" VerticalTextAlignment="Center" Text="{x:Static strings:Resources.EstimatedTime}" />
                    <Label Grid.Row="4" Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding EstimatedTime}" />
                </Grid>
            </controls:GroupBox>

            <controls:GroupBox Margin="8" Title="{x:Static strings:Resources.LastResults}">
                <CollectionView ItemsSource="{Binding BenchmarkResults}">
                    <CollectionView.Header>
                            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto,Auto">
                                <Label Grid.Column="0" Style="{StaticResource Header3}" Text="{x:Static strings:Resources.Total}" />
                                <Label Grid.Column="1" Style="{StaticResource Header3}" Text="{x:Static strings:Resources.SingleThread}" />
                                <Label Grid.Column="2" Style="{StaticResource Header3}" Text="{x:Static strings:Resources.MultiThread}" />
                                <BoxView
                                    Grid.ColumnSpan="3"
                                    Grid.Row="1"
                                    Color="{StaticResource Border}"
                                    HeightRequest="1"
                                    HorizontalOptions="Fill" />
                            </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:BenchmarkResultViewModel">
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                                <views:ResultView Grid.Column="0" BindingContext="{Binding TotalScore}" />
                                <views:ResultView Grid.Column="1" BindingContext="{Binding SingleThreadScore}" />
                                <views:ResultView Grid.Column="2" BindingContext="{Binding MultiThreadScore}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </controls:GroupBox>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>