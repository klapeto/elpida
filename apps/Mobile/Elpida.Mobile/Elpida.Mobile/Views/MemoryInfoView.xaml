<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Elpida.Mobile.ViewModels"
             x:DataType="viewmodels:MemoryInfoViewModel"
             x:Class="Elpida.Mobile.Views.MemoryInfoView">

    <VerticalStackLayout>
        <Label Text="Memory Information" Style="{StaticResource SubHeadline}" />

        <HorizontalStackLayout>
            <Label Text="Total Size:" FontAttributes="Bold" />
            <Label Text="{Binding TotalSize}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Label Text="Page Size:" FontAttributes="Bold" />
            <Label Text="{Binding PageSize}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>