<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Elpida.Mobile.Views"
             xmlns:viewModels="clr-namespace:Elpida.Mobile.ViewModels"
             xmlns:views1="clr-namespace:Elpida.Mobile.Views"
             x:Class="Elpida.Mobile.Views.SystemInfoView"
             x:DataType="viewModels:MainViewModel">
    <VerticalStackLayout>
        <Label Text="CPU Information" Style="{StaticResource SubHeadline}"/>
        <views1:CpuInfoView BindingContext="{ Binding CpuInfo}" />
        
        <Label Text="Memory Information" Style="{StaticResource SubHeadline}"/>
        <views1:CpuInfoView BindingContext="{Binding MemoryInfo}" />
    </VerticalStackLayout>
</ContentView>