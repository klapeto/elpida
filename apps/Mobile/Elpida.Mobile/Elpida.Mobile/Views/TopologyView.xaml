<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Elpida.Mobile.ViewModels"
             xmlns:views="clr-namespace:Elpida.Mobile.Views"
             x:DataType="viewmodels:TopologyViewModel"
             x:Class="Elpida.Mobile.Views.TopologyView">

	<VerticalStackLayout>
		<HorizontalStackLayout>
			<Label Text="Fastest CPU:"/>
			<Label Text="{Binding FastestProcessor}"/>
		</HorizontalStackLayout>
		<views:TopologyNodeView BindingContext="{Binding Root}"/>
	</VerticalStackLayout>
</ContentView>