<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Elpida.Mobile.ViewModels"
             x:DataType="viewModels:CpuInfoViewModel"
             x:Class="Elpida.Mobile.Views.CpuInfoView">
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Architecture:" FontAttributes="Bold" />
            <Label Text="{Binding Architecture}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Label Text="Vendor:" FontAttributes="Bold" />
            <Label Text="{Binding Vendor}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Label Text="Model Name:" FontAttributes="Bold" />
            <Label Text="{Binding ModelName}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>