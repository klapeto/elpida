<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Elpida.Mobile.Views"
             xmlns:viewmodels="clr-namespace:Elpida.Mobile.ViewModels"
             xmlns:views1="clr-namespace:Elpida.Mobile.Views"
             x:DataType="viewmodels:MainViewModel"
             x:Class="Elpida.Mobile.MainPage">

	<ScrollView>
		<VerticalStackLayout
			Padding="30,0"
			Spacing="25">
			
			<Label
				Text="Elpida"
				Style="{StaticResource Headline}"
				SemanticProperties.HeadingLevel="Level1" />
			
			<views1:SystemInfoView></views1:SystemInfoView>
			
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
