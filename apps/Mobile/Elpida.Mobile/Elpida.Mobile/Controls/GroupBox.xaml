<?xml version="1.0" encoding="utf-8"?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Elpida.Mobile.Controls"
    x:Class="Elpida.Mobile.Controls.GroupBox"
    x:DataType="controls:GroupBox">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border
                Background="#cbc7f7"
                Shadow="0 3 6 rgba(0, 0, 0, 0.14)"
                StrokeThickness="0">
                
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="7" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">
                    <VerticalStackLayout Grid.Row="0">
                        <Label Text="{TemplateBinding Title}" 
                                Style="{StaticResource GroupBoxHeader}" /> 
                        <BoxView
                            Color="#9e9fee"
                            HeightRequest="1"
                            HorizontalOptions="Fill" />
                    </VerticalStackLayout>

                    <VerticalStackLayout  Grid.Row="1" Padding="7" Background="#edf4f9">
                        <ContentPresenter />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>