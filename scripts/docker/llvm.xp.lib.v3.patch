+/// Read a string (REG_SZ or REG_EXPAND_SZ, unexpanded) or REG_DWORD value of
+/// Key, as RegGetValueW does with RRF_RT_REG_SZ or RRF_RT_REG_DWORD. Strings
+/// are null terminated, and their size includes the terminator.
+static LONG getRegValue(HKEY Key, LPCWSTR Name, bool String, PVOID Data,
+                        LPDWORD DataSize) {
+#if _WIN32_WINNT < _WIN32_WINNT_VISTA
+  // RegGetValueW is unavailable before Vista.
+  DWORD Avail = Data ? *DataSize : 0;
+  DWORD Type;
+  LONG R = ::RegQueryValueExW(Key, Name, NULL, &Type,
+                              static_cast<LPBYTE>(Data), DataSize);
+  if (R != ERROR_SUCCESS)
+    return R;
+  if (String ? Type != REG_SZ && Type != REG_EXPAND_SZ : Type != REG_DWORD)
+    return ERROR_UNSUPPORTED_TYPE;
+  if (!String)
+    return ERROR_SUCCESS;
+  if (!Data) {
+    *DataSize += sizeof(wchar_t);
+    return ERROR_SUCCESS;
+  }
+  wchar_t *Str = static_cast<wchar_t *>(Data);
+  DWORD Len = *DataSize / sizeof(wchar_t);
+  if (Len && Str[Len - 1] == L'\0')
+    return ERROR_SUCCESS;
+  if ((Len + 1) * sizeof(wchar_t) > Avail)
+    return ERROR_MORE_DATA;
+  Str[Len] = L'\0';
+  *DataSize = (Len + 1) * sizeof(wchar_t);
+  return ERROR_SUCCESS;
+#else
+  return ::RegGetValueW(Key, NULL, Name,
+                        String ? RRF_RT_REG_SZ : RRF_RT_REG_DWORD, NULL, Data,
+                        DataSize);
+#endif
+}
