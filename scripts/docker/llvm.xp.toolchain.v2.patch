 static __inline void emutls_init_once(void) {
+#if _WIN32_WINNT >= 0x0600
   static INIT_ONCE once;
   InitOnceExecuteOnce(&once, emutls_init, NULL, NULL);
+#else
+  // InitOnceExecuteOnce is unavailable before Vista. Emulate it with
+  // interlocked operations: 0 = uninitialized, 1 = in progress, 2 = done.
+  // Like InitOnceExecuteOnce, a failed initialization may be retried.
+  static volatile LONG once = 0;
+  for (;;) {
+    LONG state = InterlockedCompareExchange(&once, 1, 0);
+    if (state == 2)
+      return;
+    if (state == 0) {
+      InterlockedExchange(&once, emutls_init() ? 2 : 0);
+      return;
+    }
+    // Unlike SwitchToThread, Sleep also yields to lower priority threads,
+    // which may be the one running the initialization.
+    Sleep(1);
+  }
+#endif
 }
 
 static __inline void emutls_lock(void) { EnterCriticalSection(emutls_mutex); }
