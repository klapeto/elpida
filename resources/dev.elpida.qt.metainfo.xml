    <metadata_license>FSFAP</metadata_license>

    <name>Elpida</name>
    <summary>CPU/Algorithm benchmarking framework</summary>
    <icon type="stock">elpida</icon>
    <description>
        <p>
            Elpida is an Open Source (GPLv3) Benchmarking framework for measuring performance of computer hardware or
            algorithms. It&apos;s goal is to be as transparent and open as possible as well as extensible by the
            community. It comes with a library (libelpida), a Qt application and a set of predefined benchmarks for
            measuring computer hardware capabilities.
        </p>
    </description>
    <categories>
        <category>Utility</category>
        <category>Profiling</category>
    </categories>
    <keywords>
        <keyword>benchmark</keyword>
        <keyword>cpu</keyword>
    </keywords>
